{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vista-supply-name",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "QUOTE_ATTACHMENTS",
      "bucket_name": "vista-quote-attachments"
    }
  ],
  "observability": {
    "enabled": true
  }
}
